# Set absolute paths so runtime, SQLx macros, and migration commands use the same files.
MARKET_DATABASE_URL=sqlite:///absolute/path/to/MarketWatch/market.sqlite?mode=rwc
USER_DATABASE_URL=sqlite:///absolute/path/to/MarketWatch/user.sqlite?mode=rwc
INSTITUTIONAL_DATABASE_URL=sqlite:///absolute/path/to/MarketWatch/institutional.sqlite?mode=rwc
